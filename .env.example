# Copier la connexion PostgreSQL fournie par Neon (connexion poolée avec TLS).
# Exemple : postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Au moins 16 caractères. À garder privé. Administration : /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 1 sur Render, 0 pour un serveur local sans proxy.
TRUST_PROXY=0
PORT=3000
# Sans DATABASE_URL, stockage JSON autorisé uniquement en développement.
# NODE_ENV=production

# API pays gratuite ipwho.is ; 0 pour utiliser seulement la base locale.
GEOIP_API_ENABLED=1

# Vocal WebRTC (facultatif). URLs multiples séparées par des virgules.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
# Coturn avec use-auth-secret : secret uniquement côté serveur.
TURN_SHARED_SECRET=
# Ou identifiants d’un fournisseur TURN (ne pas remplir si secret partagé).
TURN_USERNAME=
TURN_CREDENTIAL=
# 1 impose TURN pour masquer les IP entre participants ; nécessite TURN fonctionnel.
WEBRTC_RELAY_ONLY=0
